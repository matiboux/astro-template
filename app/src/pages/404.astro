---
import { getRelativeLocaleUrl } from 'astro:i18n'

import Layout from '~/layouts/Layout.astro'

import { i18nFactory, defaultLocale } from '~/i18n'
const locale = Astro.currentLocale ?? defaultLocale
const _ = i18nFactory(locale as any)
---

<Layout>

	<p>
		<span class="icon icon-[mdi--emoticon-sad] icon-align icon-fw"></span>
		{_({
			en: 'Page not found',
			fr: 'Page introuvable',
			de: 'Seite nicht gefunden',
			es: 'Página no encontrada',
		})}
	</p>

	<p>
		<a href={getRelativeLocaleUrl(locale, '/')}>
			<span class="icon icon-[mdi--arrow-left] icon-align icon-fw"></span>
			{_({
				en: 'Go back to homepage',
				fr: "Retour à la page d'accueil",
				de: 'Zurück zur Startseite',
				es: 'Volver a la página de inicio',
			})}
		</a>
	</p>

</Layout>

<style lang="scss">
@reference "#tailwind.css";

:global(body) {
	@apply p-4;
}

p {
	@apply mb-4;

	:global(code) {
		@apply bg-gray-100 px-1 border border-gray-300 rounded;
	}
}

a {
	@apply text-blue-600 hover:text-blue-700 hover:underline;
}
</style>
